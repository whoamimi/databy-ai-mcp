# --- builder: resolve the uv-locked env into a venv -------------------------
FROM python:3.12-slim-bookworm AS builder

COPY --from=ghcr.io/astral-sh/uv:0.12.3 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /app

# phik (a ydata-profiling dependency) ships no wheel for this platform and
# builds a C++ extension via CMake, so the builder stage needs a compiler.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    && rm -rf /var/lib/apt/lists/*

# Layer 1: dependencies only, cached separately from source so code edits
# don't bust the dependency cache.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-install-project --no-dev --no-group docs

# Layer 2: install the project itself (registers the databy-ai-mcp entrypoint).
COPY src ./src
COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-group docs

# --- runtime: slim image, no compiler/uv toolchain --------------------------
FROM python:3.12-slim-bookworm

# pyspark (via fg-data-profiling's Spark support) needs a JVM at runtime, not
# just at import time — Spark 4.x requires Java 17+.
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 databy \
    && useradd --uid 1000 --gid databy --create-home --shell /usr/sbin/nologin databy

WORKDIR /app
COPY --from=builder --chown=databy:databy /app/.venv /app/.venv
COPY --from=builder --chown=databy:databy /app/src /app/src

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER databy

# FastMCP defaults to stdio transport, so the sandbox boundary is the
# container itself — invoke with `docker run -i` (see CLI steps).
ENTRYPOINT ["databy-ai-mcp"]
